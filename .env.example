# ============================================================
# DevTrack - Variaveis de Ambiente (Oracle Database)
# Copie este arquivo para .env e preencha com suas credenciais
# ============================================================

PORT=3000

# Credenciais de acesso ao Oracle Database
DB_USER=system
DB_PASSWORD=oracle
# Para Oracle 23 Free (Docker): localhost:1521/FREEPDB1
# Para Oracle XE anterior: localhost:1521/XEPDB1
DB_CONNECT_STRING=localhost:1521/FREEPDB1
